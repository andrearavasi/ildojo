---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import prodotti from "../data/products.json";
---

<BaseLayout title="Eventi" description="Scopri gli eventi in programma">
    <section class="max-w-7xl mx-auto py-16 px-4">
        <h1 class="text-4xl md:text-5xl font-bold mb-2">Eventi</h1>
        <p class="text-gray-400 mb-12">
            Rimani aggiornato sulle attività e gli eventi in programma.
        </p>

        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {prodotti.map((product) => <ProductCard product={product} />)}
        </div>
    </section>
</BaseLayout>
