---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Contatti"
    description="Vieni a trovarci o scrivici per qualsiasi domanda"
>
    <section class="max-w-4xl mx-auto py-16 px-4">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Contattaci</h1>
        <div class="grid md:grid-cols-2 gap-12">
            <div>
                <h2 class="text-2xl font-semibold mb-4">Vieni a trovarci</h2>
                <a
                    href="https://www.google.com/maps/search/?api=1&query=IlDojo,Via+Corsica,43,23843+Dolzago+LC"
                    target="_blank"
                >
                    <p class="text-gray-300">
                        📍 Via Corsica, 43, 23843 Dolzago LC
                    </p>
                </a>

                <p class="text-gray-300 mt-2">🕒 Lun - Sab: 10:00 – 19:30</p>
                <p class="text-gray-300 mt-2">
                    📞 <a href="tel:+393892545507" class="hover:text-blue-300"
                        >+39 3892545507</a
                    >
                </p>
                <p class="text-gray-300 mt-2">
                    ✉️ <a
                        href="mailto:info@tcgstore.it"
                        class="hover:text-blue-300">info@tcgstore.it</a
                    >
                </p>

                <div class="mt-8">
                    <h3 class="text-xl font-semibold mb-3">Seguici</h3>
                    <div class="flex gap-4 text-blue-400">
                        <!-- <a href="#" class="hover:text-blue-300">Facebook</a> -->
                        <a
                            href="https://www.instagram.com/ildojotcg/"
                            target="_blank"
                            class="hover:text-blue-300">Instagram</a
                        >
                        <!-- <a href="#" class="hover:text-blue-300">Discord</a> -->
                        <a
                            href="https://wa.me/3892545507"
                            target="_blank"
                            class="hover:text-blue-300">WhatsApp</a
                        >
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
