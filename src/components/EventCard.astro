---
export interface Event {
    id: number;
    nome: string;
    gioco: string;
    data: string;
    immagine: string;
    descrizione: string;
    link: string;
}

const { event } = Astro.props as { event: Event };
---

<div
    class="bg-gray-900 rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition transform hover:-translate-y-1 border border-gray-800"
>
    <img
        src={event.immagine}
        alt={event.nome}
        class="w-full h-48 object-cover"
        loading="lazy"
    />
    <div class="p-5">
        <span
            class="text-xs font-semibold uppercase tracking-wider text-blue-400"
            >{event.gioco}</span
        >
        <h3 class="text-xl font-bold mt-1 mb-2">{event.nome}</h3>
        <p class="text-gray-400 text-sm mb-4">{event.data}</p>
        <p class="text-gray-400 text-sm mb-4">{event.descrizione}</p>
        {
            event.link ? (
                <p class="text-gray-400 text-sm mb-4">
                    <a
                        href={event.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-blue-400 hover:text-blue-300 underline"
                    >
                        Link all'evento
                    </a>
                </p>
            ) : null
        }
    </div>
</div>
