---
import Layout from "../layouts/Layout.astro";
import WhatsappButton from "../scripts/WhatsappButton.jsx";

// Simulazione di dati di un prodotto (magari recuperati da un CMS o Markdown)

export interface Product {
    id: number;
    nome: string;
    gioco: string;
    prezzo: number;
    immagine: string;
    descrizione: string;
    limitato: boolean;
    esaurito: boolean;
}

const { product } = Astro.props as { product: Product };
---

<!-- Passiamo le info al componente React -->
<WhatsappButton
    client:load
    productName={product.nome}
    price={product.prezzo?.toFixed(2)}
    productCode={product.id}
    limitato={product.limitato}
    esaurito={product.esaurito}
/>

<style>
    /* Un pizzico di stile per il pulsante */
    .btn-whatsapp {
        display: inline-flex;
        align-items: center;
        background-color: #25d366;
        color: white;
        padding: 12px 24px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        transition: background-color 0.2s ease;
    }
    .btn-whatsapp:hover {
        background-color: #128c7e;
    }
</style>
