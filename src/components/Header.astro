---
import { Image } from "astro:assets";
import logoImg from "../assets/logo_bgcrop.png";
---

<header class="bg-gray-900 border-b border-gray-800 sticky top-0 z-50">
    <nav class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
        <a
            href="/ildojo"
            class="text-2xl font-bold text-blue-400 hover:text-blue-300 transition"
        >
            <Image
                src={logoImg}
                alt="Logo"
                width="60"
                height="60"
                class="mr-2 inline-block"
            />
            <!-- <img
                src="/src/assets/logo_bgcrop.png"
                alt="Logo"
                class="h-10 w-auto mr-2 inline-block"
            /> -->

            <!-- IL DOJO -->
        </a>
        <div class="flex gap-6 text-lg">
            <a href="/ildojo" class="hover:text-blue-400 transition">Home</a>
            <a href="/ildojo/prodotti" class="hover:text-blue-400 transition"
                >Prodotti</a
            >
            <a href="/ildojo/eventi" class="hover:text-blue-400 transition"
                >Eventi</a
            >
            <a href="/ildojo/contatti" class="hover:text-blue-400 transition"
                >Contatti</a
            >
        </div>
    </nav>
</header>
