---
import Image from "astro/components/Image.astro";

export interface Product {
    id: number;
    nome: string;
    gioco: string;
    prezzo: number;
    immagine: string;
    descrizione: string;
}

const { product } = Astro.props as { product: Product };
---

<div
    class="bg-gray-900 rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition transform hover:-translate-y-1 border border-gray-800"
>
    <img
        src={product.immagine}
        alt={product.nome}
        class="w-full h-48 object-cover"
        loading="lazy"
    />
    <div class="p-5">
        <span
            class="text-xs font-semibold uppercase tracking-wider text-blue-400"
            >{product.gioco}</span
        >
        <h3 class="text-xl font-bold mt-1 mb-2">{product.nome}</h3>
        <p class="text-gray-400 text-sm mb-4">{product.descrizione}</p>
        <div class="flex items-center justify-between">
            <span class="text-2xl font-bold text-green-400"
                >€ {product.prezzo.toFixed(2)}</span
            >
            <button
                class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-full text-sm font-semibold transition"
            >
                Acquista
            </button>
        </div>
    </div>
</div>
